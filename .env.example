# ===================================================
# SAENA.ID - ENVIRONMENT VARIABLES CONFIGURATION
# ===================================================

# Application
VITE_APP_NAME="Saena.id"
VITE_API_URL="/api"
PORT=3000

# DOKU Payment Gateway
# Obtain these credentials from DOKU Back Office (Sandbox / Production)
# Docs: https://jokul.doku.com / https://developers.doku.com
DOKU_CLIENT_ID="MALL-CLIENT-ID-EXAMPLE"
DOKU_SECRET_KEY="SK-DOKU-SECRET-KEY-EXAMPLE"
# Set to 'sandbox' for development or 'production' for live transactions
DOKU_ENVIRONMENT="sandbox"

# Mengantar Shipping Aggregator
# Obtain API key from Mengantar Dashboard
# Base URL: https://api-sandbox.mengantar.com (sandbox) or https://api.mengantar.com (prod)
MENGANTAR_API_KEY="MENGANTAR_SECRET_API_KEY"
MENGANTAR_BASE_URL="https://api.mengantar.com"

# Origin shipping postal code / subdistrict for Saena Warehouse
MENGANTAR_ORIGIN_SUBDISTRICT="Cilandak, Jakarta Selatan"
MENGANTAR_ORIGIN_POSTAL_CODE="12430"

# Authentication & Security
AUTH_SECRET="saena_super_secret_jwt_key_change_in_production"
ADMIN_KEY="admin_saena_secret_pass"

# Database (Optional for remote PostgreSQL; in-memory fallback enabled by default)
DATABASE_URL=""
