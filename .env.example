# ===================================================
# SAENA.ID - ENVIRONMENT VARIABLES CONFIGURATION (PRODUCTION)
# ===================================================

# Application
NODE_ENV="production"
PORT=3000
APP_URL="https://your-project.vercel.app"
VITE_APP_NAME="Saena.id"
VITE_API_URL="/api"

# PostgreSQL Database (Required for Production Persistence)
# Example: postgresql://saena_user:secure_password@postgres.host:5432/saena_db?sslmode=require
DATABASE_URL="postgresql://username:password@hostname:5432/saena_db"

# JWT Authentication & Cryptographic Secret
# Generasikan secret acak minimal 32 karakter
AUTH_SECRET="your-high-entropy-jwt-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Initial Super Admin (Digunakan oleh seed script saat pertama kali database diinisialisasi)
ADMIN_INITIAL_EMAIL="admin@saena.id"
ADMIN_INITIAL_PASSWORD="ChangeThisStrongPassword123!"

# DOKU Jokul Payment Gateway (Official Integration)
# Dapatkan Client ID dan Secret Key dari Back Office DOKU (https://jokul.doku.com)
DOKU_CLIENT_ID="YOUR_DOKU_CLIENT_ID"
DOKU_SECRET_KEY="YOUR_DOKU_SECRET_KEY"
# Gunakan 'sandbox' saat testing, 'production' untuk transaksi live
DOKU_ENVIRONMENT="sandbox"

# Mengantar Shipping Aggregator
# Dapatkan API Key resmi dari Dashboard Mengantar (https://mengantar.com)
MENGANTAR_API_KEY="YOUR_MENGANTAR_API_KEY"
MENGANTAR_BASE_URL="https://api-public.mengantar.com"
MENGANTAR_ORIGIN_SUBDISTRICT="Cilandak"
MENGANTAR_ORIGIN_POSTAL_CODE="12430"
